<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Compression: static-content compression only. Safe even when the
             IIS Dynamic Compression module is absent (attribute is ignored,
             never a 500.19). Linux panels use .htaccess / nginx gzip above. -->
        <urlCompression doStaticCompression="true" doDynamicCompression="false" />
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                    <add segment="app" />
                    <add segment="bootstrap" />
                    <add segment="config" />
                    <add segment="database" />
                    <add segment="resources" />
                    <add segment="routes" />
                    <add segment="storage" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        <rewrite>
            <rules>
                <!-- The upload folders never run a script, before the fallback below forwards them into public/
                     (the same expressions as the root .htaccess and docs/server-configs/). IIS hands these rules down to
                     public/web.config as well, so their names differ from the ones there. -->
                <rule name="Project folder: upload folders never run a script" stopProcessing="true">
                    <match url="^(public/)?(storage|uploads)/(.*/)?[^/]*\.ph(p[0-9]*|ar|tml|t|ps)(\.|/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- Dotfiles in any folder are never handed out; ACME challenges (.well-known/) still work. -->
                <rule name="Project folder: dotfiles are never handed out" stopProcessing="true">
                    <match url="(^|/)\.(?!well-known(/|$))" ignoreCase="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- A database dump, a log or a backup copy that lands in public/ is never handed out (only an existing
                     file: the site's own addresses that end like that still reach the application). -->
                <rule name="Project folder: dumps, logs and backup copies are never handed out" stopProcessing="true">
                    <match url="^(public/)?(.+(\.(sql|sqlite3?|db|dump|log|bak|backup|old|orig|save|swp|gz|tgz|tar)|~))$" ignoreCase="true" />
                    <conditions>
                        <add input="{APPL_PHYSICAL_PATH}public\{R:2}" matchType="IsFile" />
                    </conditions>
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="AVDBCMS project-root fallback" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{URL}" pattern="^/public/" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
