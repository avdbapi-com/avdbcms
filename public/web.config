<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- The upload folders (storage/ = the public disk, uploads/ = the folder of older releases) serve
                     pictures and never run a script: .php, .php3 ... .php8, .phar, .phtml, .pht, .phps, also as
                     x.php.jpg or x.php/extra. The same expressions as public/.htaccess and docs/server-configs/. -->
                <rule name="Upload folders never run a script" stopProcessing="true">
                    <match url="^(storage|uploads)/(.*/)?[^/]*\.ph(p[0-9]*|ar|tml|t|ps)(\.|/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- Dotfiles (.env, .git, .user.ini ...) are never handed out; ACME challenges (.well-known/) still work. -->
                <rule name="Dotfiles are never handed out" stopProcessing="true">
                    <match url="(^|/)\.(?!well-known(/|$))" ignoreCase="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- A database dump, a log or a backup copy that lands in public/ is never handed out (only an existing
                     file: the site's own addresses that end like that, an admin's download of a backup or a log, still
                     reach index.php). -->
                <rule name="Dumps, logs and backup copies are never handed out" stopProcessing="true">
                    <match url="(\.(sql|sqlite3?|db|dump|log|bak|backup|old|orig|save|swp|gz|tgz|tar)|~)$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>
                <rule name="Laravel front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>
    </system.webServer>
</configuration>
