APP_NAME=AVDBCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_INSTALLED=false
INSTALL_SQL_BACKUP=

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avdbcms
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log

CACHE_DRIVER=file
LIMITER_DRIVER=file
PUBLIC_SEARCH_CACHE_TTL=60

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

# auto-detect streaming accelerator (nginx / apache / litespeed / none)
STREAM_ACCELERATOR=auto
# comma-separated proxies (or * for trust-all); blank = none
SITE_TRUSTED_PROXIES=
# auto | queue | process | inline
# auto starts imports immediately when PHP subprocesses are available.
# Use queue in production only when Horizon or queue:work is supervised.
AVDB_IMPORT_MODE=auto
# auto | process | queue | off
# auto follows AVDB_IMPORT_MODE: process for auto/process/inline imports, queue for queue imports.
AVDB_DURATION_BACKFILL_MODE=auto
# Concurrent Upload18/player duration lookups. Avoid unlimited values; high concurrency can trigger rate limits.
AVDB_DURATION_REMOTE_CONCURRENCY=10
AVDB_DURATION_REMOTE_TIMEOUT=8
# Optional absolute PHP CLI paths. Leave blank to auto-detect.
AVDB_IMPORT_PHP_BINARY=
AVDB_DURATION_PHP_BINARY=
CRON_PHP_BINARY=
QUEUE_WORKER_PHP_BINARY=
REDIS_QUEUE=default
UPLOADS_QUEUE=uploads
THUMBNAILS_QUEUE=thumbnails
DATABASE_QUEUE_RETRY_AFTER=1900
REDIS_QUEUE_RETRY_AFTER=1900
REDIS_QUEUE_BLOCK_FOR=5

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_CONNECTION=session
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_DB=0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3

HORIZON_MAX_PROCESSES=4
HORIZON_PRODUCTION_MAX_PROCESSES=10
HORIZON_WORKER_TIMEOUT=1800
HORIZON_WORKER_TRIES=2
HORIZON_WORKER_MEMORY=256

# Leave blank to auto-detect bundled portable binaries in bin/.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_BINARY=
FFPROBE_BINARY=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio-id
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=avdbcms
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://127.0.0.1:9000/avdbcms
AWS_USE_PATH_STYLE_ENDPOINT=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_WEBSOCKETS_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_WEBSOCKETS_HOST="${PUSHER_WEBSOCKETS_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SUPPORT_EMAIL=support@example.com
SERVER_EMAIL=server@example.com
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=43200
ADMIN_OPERATIONAL_TOOLS_ENABLED=true

STATISTICS_ENABLED=false
IGNORE_IPS=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

CASHIER_CURRENCY=eur
CASHIER_LOGGER=stack

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

SCOUT_DRIVER=collection
MEILISEARCH_HOST=
MEILISEARCH_KEY=

YOUTUBE_API_KEY=
BREVO_API_KEY=

UPLOAD18_API_KEY=
UPLOAD18_API_URL=https://upload18.org/api
UPLOAD18_DEFAULT_CID=15
UPLOAD18_DEFAULT_MYCID=0
UPLOAD18_DEFAULT_FID=18
UPLOAD18_ALLOW_SERVER_FALLBACK=false


LOG_VIEWER_API_STATEFUL_DOMAINS=example.com

CHOKIDAR_USEPOLLING=true
CHOKIDAR_IGNORE_INITIAL=true
