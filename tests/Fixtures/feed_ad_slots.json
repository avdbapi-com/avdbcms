{
    "_about": "List ad places, one rule for VideosList (resources/js/components/Videos/feedSlots.ts, run by tests/js/feed_ad_slots.test.ts) and the server (App\\Support\\FeedAdSlots, run by tests/Unit/FeedAdSlotsTest.php). 'Ad after every N' = N videos before each ad (a full-width row W: after the row that holds video N, 2N, ...). card 'expect': runs such as '8v A 15v' (8 videos, a card ad, 15 videos; W = a full-width ad row); reserve = a growing grid-card feed (complete rows only); maxAds 0 = no limit.",
    "card": [
        {"name": "desktop, 4 columns, N 8 (new site): 8 videos, then the ad, complete rows", "videos": 24, "columns": 4, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "8v A 15v"},
        {"name": "phone, 2 columns, N 8: 8 videos, then the ad, complete rows", "videos": 24, "columns": 2, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "8v A 15v"},
        {"name": "phone, 1 column: every video shows, the ad after video 8", "videos": 24, "columns": 1, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "8v A 16v"},
        {"name": "a list of N videos shows no card ad", "videos": 8, "columns": 4, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "8v"},
        {"name": "a list of fewer than N videos shows no card ad", "videos": 5, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "expect": "5v"},
        {"name": "N + 1 videos, pagination: the ad between video 8 and 9", "videos": 9, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "expect": "8v A 1v"},
        {"name": "N + 1 videos, growing feed: only complete rows, the ad waits", "videos": 9, "columns": 4, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "8v"},
        {"name": "pagination, 4 columns: all videos, the ad after video 8", "videos": 24, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "expect": "8v A 16v"},
        {"name": "Most ads per list 2 caps the count", "videos": 48, "columns": 4, "every": 8, "maxAds": 2, "reserve": true, "maxRows": 0, "expect": "8v A 8v A 30v"},
        {"name": "Most ads per list 0 = no limit, one column", "videos": 30, "columns": 1, "every": 8, "maxAds": 0, "reserve": true, "maxRows": 0, "expect": "8v A 8v A 8v A 6v"},
        {"name": "no limit, N 3, 4 columns: complete rows end with an ad that has videos after it", "videos": 12, "columns": 4, "every": 3, "maxAds": 0, "reserve": true, "maxRows": 0, "expect": "3v A 3v A 3v A"},
        {"name": "N 1: an ad after every video", "videos": 4, "columns": 1, "every": 1, "maxAds": 0, "reserve": false, "maxRows": 0, "expect": "1v A 1v A 1v A 1v"},
        {"name": "rail of 2 rows x 4, N 8: no room after 8 videos", "videos": 8, "columns": 4, "every": 8, "maxAds": 1, "reserve": true, "maxRows": 2, "expect": "8v"},
        {"name": "rail of 2 rows x 4, N 7: the ad takes the last place", "videos": 8, "columns": 4, "every": 7, "maxAds": 1, "reserve": true, "maxRows": 2, "expect": "7v A"},
        {"name": "rail of 2 rows x 4, N 7, only 7 videos: no ad at the end", "videos": 7, "columns": 4, "every": 7, "maxAds": 1, "reserve": true, "maxRows": 2, "expect": "7v"},
        {"name": "rail of 2 rows x 4, N 6", "videos": 8, "columns": 4, "every": 6, "maxAds": 1, "reserve": true, "maxRows": 2, "expect": "6v A 1v"},
        {"name": "short list, one row: every video with the ad between them", "videos": 3, "columns": 4, "every": 2, "maxAds": 1, "reserve": true, "maxRows": 0, "expect": "2v A 1v"},
        {"name": "ads off", "videos": 10, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "adsEnabled": false, "expect": "10v"},
        {"name": "wide rows: a full-width row after video 8", "videos": 24, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "layout": "wide_row", "expect": "8v W 16v"},
        {"name": "wide rows in a rail of 2 rows x 4, N 8: the row after the rail", "videos": 10, "columns": 4, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 2, "layout": "wide_row", "expect": "8v W"},
        {"name": "wide rows, 3 columns (1200-1399 px), N 8: after the row that holds video 8", "videos": 24, "columns": 3, "every": 8, "maxAds": 1, "reserve": false, "maxRows": 0, "layout": "wide_row", "expect": "9v W 15v"},
        {"name": "wide rows, one column, N 8, no limit", "videos": 20, "columns": 1, "every": 8, "maxAds": 0, "reserve": false, "maxRows": 0, "layout": "wide_row", "expect": "8v W 8v W 4v"}
